# ─────────────────────────────────────────────────
# StockPilot — Variables de Entorno
# ─────────────────────────────────────────────────
# Copia este archivo como .env y completa los valores.
#   cp .env.example .env   (Linux/Mac)
#   copy .env.example .env (Windows)

# Entorno de ejecución: "development" o "production"
NODE_ENV=development

# Puerto donde corre el servidor backend
PORT=3001

# ── Base de datos ──────────────────────────────────
# Cadena de conexión a PostgreSQL
# Formato: postgresql://usuario:contraseña@host:puerto/nombre_bd
# Ejemplo local: postgresql://postgres:1234@localhost:5432/stockpilot
# Ejemplo Neon:  postgresql://usuario:xxxx@ep-xxxx.neon.tech/stockpilot?sslmode=require
DATABASE_URL=postgresql://postgres:contraseña@localhost:5432/stockpilot

# ── Caché / Sesiones ─────────────────────────────────
# Cadena de conexión a Redis (Opcional - Si no se provee, usa PostgreSQL/Memoria local)
# REDIS_URL=redis://localhost:6379

# ── Sesiones ──────────────────────────────────────
# Cadena aleatoria larga para firmar las cookies de sesión.
# Genera una en la terminal con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# ⚠️  OBLIGATORIO en producción — el servidor no arrancará sin este valor.
SESSION_SECRET=

# ── URLs ──────────────────────────────────────────
# URL pública de la aplicación (usada en los emails de alertas y recuperación de contraseña)
# Desarrollo: http://localhost:5173
# Producción: https://tu-dominio.com
APP_URL=http://localhost:5173

# URL(s) del frontend permitidas por CORS (separadas por coma si son varias)
# Desarrollo: http://localhost:5173
# Producción: https://tu-dominio.com
CORS_ORIGIN=http://localhost:5173

# ── OpenAI ────────────────────────────────────────
# API Key para el módulo de Inteligencia Artificial de Reabastecimiento
# Obtener en: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-tu_api_key_aqui

# ── Correo ────────────────────────────────────────
# Opción A (producción recomendada): Resend — funciona en Render/Heroku sin bloqueos SMTP
# Crear cuenta gratis en https://resend.com → API Keys → Create API Key
RESEND_API_KEY=re_tu_api_key_aqui

# Opción B (desarrollo local): Gmail SMTP con "Contraseña de aplicación"
# Si RESEND_API_KEY está definido, estas variables son ignoradas.
# Guía App Password: https://support.google.com/accounts/answer/185833
EMAIL_USER=tu_correo@gmail.com
EMAIL_PASS=tu_contraseña_de_aplicacion

# ── Motor de alertas (plan 17, O8) ─────────────────
# Interruptor de emergencia: si se detecta un problema en producción con Alert.generate(), poner en
# "true" lo apaga por completo (disparadores automáticos y botón manual) sin necesidad de un nuevo
# despliegue. No reactiva ninguna lógica vieja — esa ya no existe en el código.
# DISABLE_ALERT_ENGINE=true

# ── Política de 2FA del Administrador ───────────────
# "true" obliga a los administradores a activar la verificación en dos pasos antes de modificar datos:
# la API responde 403 con code DOS_FACTORES_REQUERIDO a sus escrituras (leer, entrar, salir y activar el
# 2FA siguen permitidos). Apagada por defecto: durante el piloto el 2FA es una recomendación, porque
# todavía no hay códigos de recuperación. Se cambia con un reinicio del servicio, sin tocar código.
# REQUIRE_ADMIN_2FA=true
