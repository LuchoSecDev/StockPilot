{
  "name": "inventario-node",
  "version": "1.0.0",
  "main": "app.js",
  "scripts": {
    "start": "node app.js",
    "predev": "kill-port 3000",
    "dev": "npx nodemon app.js",
    "build": "npm run build:frontend",
    "build:frontend": "cd frontend && npm install --include=dev && npm run build",
    "migrate": "node scripts/migrate.js",
    "equipo:crear": "node scripts/equipo_crear.js",
    "seed": "node database/seed_test_data.js",
    "demo:sembrar": "node -r dotenv/config database/seed_demo.js dotenv_config_path=.env.demo",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.js",
    "test:evidence": "node scripts/run_evidence.js",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:coverage:combinada": "node scripts/cobertura_combinada.mjs",
    "test:dashboard": "vitest --ui",
    "test:ui": "npx playwright test --ui"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "bcrypt": "^6.0.0",
    "compression": "^1.8.2",
    "connect-pg-simple": "^10.0.0",
    "connect-redis": "^10.0.0",
    "cors": "^2.8.5",
    "csrf-sync": "^4.2.1",
    "dotenv": "^16.0.0",
    "exceljs": "^4.3.0",
    "express": "^4.22.3",
    "express-rate-limit": "^8.7.0",
    "express-session": "^1.17.3",
    "file-type": "^22.1.1",
    "helmet": "^7.1.0",
    "multer": "^2.2.0",
    "node-cron": "^4.6.0",
    "nodemailer": "^10.0.10",
    "openai": "^4.20.1",
    "otplib": "^12.0.1",
    "pdfkit": "^0.13.0",
    "pg": "^8.11.3",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "qrcode": "^1.5.4",
    "rate-limit-redis": "^6.0.1",
    "redis": "^6.2.1",
    "resend": "^6.12.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@vitejs/plugin-react": "^4.3.4",
    "@vitest/coverage-v8": "^4.1.4",
    "@vitest/ui": "^4.1.4",
    "kill-port": "^2.0.1",
    "supertest": "^7.3.0",
    "vitest": "^4.1.4"
  },
  "description": "",
  "type": "commonjs",
  "engines": {
    "node": ">=22"
  },
  "overrides": {
    "uuid": "^11.1.1"
  }
}
